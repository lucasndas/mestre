<Configuration>
  <Networking>Enable</Networking>
  <MemoryInMB>8192</MemoryInMB>
  <MappedFolders>
    <MappedFolder>
      <HostFolder>C:\mestre\tools\winsandbox</HostFolder>
      <SandboxFolder>C:\winsandbox</SandboxFolder>
      <ReadOnly>false</ReadOnly>
    </MappedFolder>
  </MappedFolders>
  <LogonCommand>
    <Command>cmd.exe /c start "Mestre - rodada" powershell.exe -NoExit -NoProfile -ExecutionPolicy Bypass -File C:\winsandbox\setup.ps1 -Round -Branch main</Command>
  </LogonCommand>
</Configuration>
