<!-- Windows Sandbox for the Windows spikes of M1. See docs/desenvolvimento/ambiente.md. -->
<!-- Expects the repository cloned at C:\mestre on the host. -->
<Configuration>
  <Networking>Enable</Networking>
  <MemoryInMB>8192</MemoryInMB>
  <MappedFolders>
    <MappedFolder>
      <HostFolder>C:\mestre\tools\winsandbox</HostFolder>
      <SandboxFolder>C:\winsandbox</SandboxFolder>
      <ReadOnly>false</ReadOnly>
    </MappedFolder>
  </MappedFolders>
  <LogonCommand>
    <Command>cmd.exe /c start "Mestre - preparo" powershell.exe -NoExit -NoProfile -ExecutionPolicy Bypass -File C:\winsandbox\setup.ps1</Command>
  </LogonCommand>
</Configuration>
