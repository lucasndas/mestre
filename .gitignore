# testrun: local history of heavy-suite timings (docs/qualidade/testes.md)
/.testrun/

# The panel bundle built by `vite build` (web/); .gitkeep keeps the folder for
# the go:embed pattern (docs/desenvolvimento/convencoes.md).
/internal/panel/webdist/*
!/internal/panel/webdist/.gitkeep
/web/node_modules/
/web/test-results/
/web/.vitest/
/e2eserver
/e2eserver.exe

# Binaries left by `go build` inside a tool's folder.
/tools/codecheck/codecheck
/tools/conformance/conformance
/tools/docscheck/docscheck
/tools/e2eserver/e2eserver
/tools/realaccount/realaccount
/tools/rulesetcheck/rulesetcheck
/tools/testrun/testrun
/tools/winsandbox/winsandbox
/tools/*/*.exe
